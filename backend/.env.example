## Copy this file to .env and fill values.
## Required keys are marked REQUIRED. Others are optional.

# Environment Mode
# Valid values: local, staging, production
ENV_MODE=local

##### DATABASE (REQUIRED)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

##### REDIS
# Use "redis" when using docker compose, or "localhost" for fully local
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Set false for local/docker compose
REDIS_SSL=false
# Enable Redis Cluster mode and provide startup nodes (comma-separated host:port)
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=
# Optional: Dramatiq broker namespace (use {tag} to pin Redis Cluster slot)
REDIS_BROKER_NAMESPACE=

##### CANVAS REALTIME (Optional)
# Route all canvas writes through realtime /apply
CANVAS_REALTIME_WRITE_ENABLED=true
# Enforce client-provided ids for add_node/add_connection
CANVAS_ENFORCE_CLIENT_IDS=false
# Emergency kill switch: force selected workspaces to legacy path (comma-separated)
CANVAS_FORCE_LEGACY_WORKSPACES=
# Canvas-native runtime rollout flags
CANVAS_NATIVE_RUNTIME_ENABLED=false
CANVAS_NATIVE_RUNTIME_SHADOW=false
CANVAS_NATIVE_VERIFY_ENABLED=false
CANVAS_NATIVE_MAX_REPAIR_ATTEMPTS=2
CANVAS_NATIVE_BEST_PATH_ENABLED=true
CANVAS_NATIVE_PLAN_BUDGET_MS=20
CANVAS_NATIVE_LAYOUT_BUDGET_MS=24
CANVAS_NATIVE_LAYOUT_COLLISION_PASS_LIMIT=2

##### AGENT RUN RELIABILITY (Optional)
# Background reaper to mark stuck runs as failed
AGENT_RUN_REAPER_ENABLED=true
AGENT_RUN_REAPER_INTERVAL_SEC=60
AGENT_RUN_STALE_THRESHOLD_SEC=180
# Worker heartbeat cadence for active runs
AGENT_RUN_HEARTBEAT_INTERVAL_SEC=15
# Stream writer micro-batching (reduce Redis round-trips under high chunk throughput)
AGENT_STREAM_WRITE_BATCH_SIZE=8
AGENT_STREAM_WRITE_BATCH_WINDOW_MS=8
# Async runtime tuning for LangGraph worker hot path
LANGGRAPH_ASYNC_EVENT_PERSIST=true
LANGGRAPH_ASYNC_EVENT_QUEUE_SIZE=256
LANGGRAPH_ASYNC_CHECKPOINT=true
LANGGRAPH_ASYNC_CHECKPOINT_QUEUE_SIZE=2
# Status event persistence policy (message table write pressure control)
# false + terminal_only=true => persist terminal statuses only
LANGGRAPH_PERSIST_STATUS_EVENTS=false
LANGGRAPH_PERSIST_STATUS_TERMINAL_ONLY=true
LANGGRAPH_PERSIST_STATUS_TYPES=run_completed,run_stopped,run_max_iterations,error

##### OUTBOX RELAY (Optional)
# Polling interval for outbox relay worker
OUTBOX_RELAY_INTERVAL_SEC=2
# Max events processed per polling batch
OUTBOX_RELAY_BATCH_SIZE=100
# Event publisher: logging | redis
OUTBOX_PUBLISHER=logging
# Redis channel for domain events
OUTBOX_REDIS_CHANNEL=domain_events
# Max publish attempts before skipping (empty = infinite)
OUTBOX_MAX_ATTEMPTS=
# If true, write request fails when outbox record fails
OUTBOX_RECORD_STRICT=true

##### PROJECTION WORKER (Optional)
PROJECTION_WORKER_INTERVAL_SEC=2
PROJECTION_NAMES=canvas_share_projection,canvas_search_projection,event_audit_projection
EVENT_AUDIT_RETENTION_DAYS=180

##### IDEMPOTENCY (Optional)
# Cache TTL for idempotent responses
IDEMPOTENCY_TTL_SEC=3600
# Lock TTL for in-flight idempotent requests
IDEMPOTENCY_LOCK_TTL_SEC=30
# Max response bytes to cache per idempotent request
IDEMPOTENCY_MAX_BODY_BYTES=65536

##### LLM PROVIDERS (At least one is functionally REQUIRED)
# Provide at least one of the following:
# Recommended gateway: Ewo. Default text model: habitat/gpt-5.6-sol.
# Stored habitat/... IDs remain compatible; ewo/... aliases are also accepted.
EWO_API_KEY=
EWO_API_BASE=https://eapi.site/v1
# Legacy credentials remain supported; no key rotation is required.
HABITAT_API_KEY=
HABITAT_API_BASE=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=global
VERTEXAI_API_BASE=
VERTEXAI_CREDENTIALS=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Default API version can be overridden if Azure releases a new stable version
AZURE_OPENAI_API_VERSION=2024-06-01
# Map canonical model ids (e.g., gpt-5.4) to your Azure deployment names
AZURE_OPENAI_DEPLOYMENTS={"gpt-5.4":"gpt54-prod"}

# AWS Bedrock (only if using Bedrock)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=

# OpenAI-compatible
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_API_BASE=

# LLM reliability (optional)
LLM_REQUEST_TIMEOUT_SEC=60
LLM_STREAM_IDLE_TIMEOUT_SEC=90
# Comma-separated list or JSON array. Leave empty to disable fallback.
LLM_FALLBACK_MODELS=habitat/gemini-3.5-flash
# Optional compatibility switch: force legacy gemini/google ids to habitat gateway.
LLM_FORCE_HABITAT_GEMINI_REDIRECT=false

##### AIPING (OpenAI-compatible)
AIPING_API_KEY=

##### DATA / SEARCH
# RAPID_API_KEY is optional (only needed to enable Rapid-based data providers)
RAPID_API_KEY=
# TAVILY_API_KEY is required for search
TAVILY_API_KEY=

##### WEB SCRAPE (REQUIRED)
FIRECRAWL_API_KEY=
# Default used if empty: https://api.firecrawl.dev
FIRECRAWL_URL=

##### SKILLS MARKETPLACE (Optional)
# SkillsMP.com API credentials for browsing 63,000+ Claude Code skills
SKILLSMP_API_KEY=
# Default used if empty: https://skillsmp.com/api/v1
SKILLSMP_BASE_URL=
# Optional: Max retries (default: 3)
SKILLSMP_MAX_RETRIES=3
# Optional: Request timeout in seconds (default: 30)
SKILLSMP_TIMEOUT=30


##### SECURITY & WEBHOOKS (Recommended)
MCP_CREDENTIAL_ENCRYPTION_KEY=
WEBHOOK_BASE_URL=http://localhost:8013
TRIGGER_WEBHOOK_SECRET=
QSTASH_TOKEN=
QSTASH_BASE_URL=https://qstash.upstash.io
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional local fallback (never use in production)
QSTASH_ALLOW_NOOP=false

##### OBSERVABILITY (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LangSmith tracing (LangChain observability platform)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# LangGraph dev server (Studio / CORS)
# Comma-separated origins, use * only for local dev/testing
LANGGRAPH_API_ALLOWED_ORIGINS=http://localhost:2024,http://127.0.0.1:2024,https://smith.langchain.com

# LangGraph supervisor/routing
LANGGRAPH_SUPERVISOR_ENABLED=true
LANGGRAPH_SUPERVISOR_MODE=handoff_only
LANGGRAPH_ROUTER_ENABLED=true
# When true, only routed subagent transfer tools are exposed (strict delegation gate).
LANGGRAPH_ROUTER_HARD_GATE=false
# Skill auto-run: if enabled, high-confidence matched skills will be forced as the first tool call.
ZMIND_SKILLS_AUTO_RUN=false
# Minimum matcher score (0-10) required for auto-run when a score is available.
ZMIND_SKILLS_AUTO_RUN_SCORE=7
# Command hook execution policy for untrusted skills: allow | skip | deny.
ZMIND_SKILLS_COMMAND_HOOKS_MODE=deny
# Prompt hook execution policy (prompt hooks are currently unsupported): skip | deny.
ZMIND_SKILLS_PROMPT_HOOKS_MODE=skip

# LangGraph subgraphs (experimental)
# When enabled, deep research runs via a parent wrapper graph with `subgraphs=True` streaming semantics.
LANGGRAPH_SUBGRAPH_ENABLED=false

##### STORAGE (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_FORCE_PATH_STYLE=true
R2_BUCKET_DEV=zmind-files-dev
R2_BUCKET_PROD=zmind-files-prod
R2_SIGNED_URL_TTL_SECONDS=600
R2_MULTIPART_THRESHOLD_BYTES=10485760
R2_MULTIPART_PART_SIZE_BYTES=8388608
FILE_PROCESSING_MAX_BYTES=52428800
FILE_PROCESSING_TEXT_MAX_CHARS=100000

##### BILLING (Optional;)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_PLAN_ID=
STRIPE_DEFAULT_TRIAL_DAYS=14
BILLING_PROVIDER_DEFAULT=payments
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_API_BASE=https://api.creem.io
CREEM_TIER_2_20_ID=
CREEM_TIER_6_50_ID=
CREEM_TIER_12_100_ID=
CREEM_TIER_25_200_ID=
CREEM_TIER_50_400_ID=
CREEM_TIER_125_800_ID=
CREEM_TIER_200_1000_ID=
CREEM_TIER_2_20_YEARLY_ID=
CREEM_TIER_6_50_YEARLY_ID=
CREEM_TIER_12_100_YEARLY_ID=
CREEM_TIER_25_200_YEARLY_ID=
CREEM_TIER_50_400_YEARLY_ID=
CREEM_TIER_125_800_YEARLY_ID=
CREEM_TIER_200_1000_YEARLY_ID=
CREEM_TIER_2_17_YEARLY_COMMITMENT_ID=
CREEM_TIER_6_42_YEARLY_COMMITMENT_ID=
CREEM_TIER_25_170_YEARLY_COMMITMENT_ID=
CREEM_CREDITS_10_PRODUCT_ID=
CREEM_CREDITS_25_PRODUCT_ID=
CREEM_CREDITS_50_PRODUCT_ID=
CREEM_CREDITS_100_PRODUCT_ID=
CREEM_CREDITS_250_PRODUCT_ID=
CREEM_CREDITS_500_PRODUCT_ID=
CREEM_REFILL_TIER_2_20_ID=
CREEM_REFILL_TIER_6_50_ID=

##### INVITE MODE (Optional; early access)
INVITE_MODE_ENABLED=true
INVITE_REWARD_PRE_STRIPE_USD=10
INVITE_REWARD_POST_STRIPE_USD=10
INVITE_CREDIT_EXPIRE_DAYS=30
INVITE_ONLY_NEW_ACCOUNTS=false

##### ADMIN
ZMIND_ADMIN_API_KEY=

##### INTEGRATIONS
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
COMPOSIO_API_BASE=https://backend.composio.dev

# Pipedream (optional; for MCP)
PIPEDREAM_PROJECT_ID=
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_X_PD_ENVIRONMENT=development

##### GOOGLE INTEGRATIONS (Optional; for Google Slides upload)
# Google OAuth credentials for Google Slides integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8013/api/google/callback
FRONTEND_URL=http://localhost:3000

# CORS settings (optional; add your frontend domains)
# Comma-separated list of allowed origins in addition to defaults
CORS_EXTRA_ORIGINS=
# Regex to allow dynamic origins (e.g., your Vercel preview domains)
# Example: https://.*\.vercel\.app
CORS_ALLOW_ORIGIN_REGEX=

ZENDESK_AUTH_CONFIG=""
# Feature flags
FEATURE_TRIGGERS=false

# Tool visibility policy (agent_config-driven allow/deny)
ENABLE_TOOL_POLICY_FILTER=false

# Tool output governance (only affects LLM context; DB/SSE keep full)
TOOL_MESSAGE_CONTEXT_MAX_CHARS=8000
# head | head_tail
TOOL_MESSAGE_CONTEXT_TRUNCATE_MODE=head

# SKILL.md discovery (file-based skills)
# Relative paths are resolved from the repo root.
ZMIND_SKILLS_PATH=.zmind/skills
ZMIND_ENABLE_CLAUDE_SKILLS=false
ZMIND_ENABLE_GLOBAL_SKILLS=false
ZMIND_GLOBAL_SKILLS_PATH=~/.config/zmind/skills
