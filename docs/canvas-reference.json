      "content": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 400 400\">\n  <defs>\n    <marker id=\"arrowhead\" markerWidth=\"10\" markerHeight=\"7\" refX=\"0\" refY=\"3.5\" orient=\"auto\">\n      <polygon points=\"0 0, 10 3.5, 0 7\" fill=\"#333\" id=\"svg-el-polygon-1762829793910-0\"/>\n    </marker>\n  </defs>\n\n  <!-- Circle of Concern -->\n  <circle cx=\"200\" cy=\"200\" r=\"180\" fill=\"#f0f0f0\" stroke=\"#ccc\" stroke-width=\"2\" id=\"svg-el-circle-1762829793910-1\"/>\n  <text x=\"200\" y=\"380\" text-anchor=\"middle\" font-size=\"20\" fill=\"#666\" id=\"svg-el-text-1762829793910-2\">关注圈 (Circle of Concern)</text>\n\n  <!-- Circle of Influence -->\n  <circle cx=\"200\" cy=\"200\" r=\"100\" fill=\"#d0e0f0\" stroke=\"#6699cc\" stroke-width=\"2\" id=\"svg-el-circle-1762829793910-3\"/>\n  <text x=\"200\" y=\"210\" text-anchor=\"middle\" font-size=\"20\" font-weight=\"bold\" fill=\"#336699\" id=\"svg-el-text-1762829793910-4\">影响圈 (Circle of Influence)</text>\n\n  <!-- Arrows indicating focus -->\n  <line x1=\"200\" y1=\"200\" x2=\"280\" y2=\"120\" stroke=\"#333\" stroke-width=\"2\" marker-end=\"url(#arrowhead)\" id=\"svg-el-line-1762829793910-5\"/>\n  <text x=\"290\" y=\"110\" font-size=\"14\" fill=\"#333\" id=\"svg-el-text-1762829793910-6\">积极主动者关注</text>\n\n  <line x1=\"200\" y1=\"200\" x2=\"120\" y2=\"280\" stroke=\"#333\" stroke-width=\"2\" marker-end=\"url(#arrowhead)\" id=\"svg-el-line-1762829793910-7\"/>\n  <text x=\"100\" y=\"295\" font-size=\"14\" fill=\"#333\" id=\"svg-el-text-1762829793910-8\">消极被动者关注</text>\n\n  <text x=\"200\" y=\"50\" text-anchor=\"middle\" font-size=\"24\" font-weight=\"bold\" fill=\"#333\" id=\"svg-el-text-1762829793910-9\">积极主动原理</text>\n</svg>",
